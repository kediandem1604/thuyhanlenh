{
  "name": "thuy-han-lenh",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Thủy Hàn Lệnh — hệ thống quản lý bang hội Nghịch Thủy Hàn",
  "scripts": {
    "dev": "concurrently -k -n web,api -c yellow,cyan \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch --clear-screen=false --tsconfig server/tsconfig.json server/src/index.ts",
    "build": "npm run typecheck && vite build && node scripts/precompress.mjs",
    "typecheck": "tsc --noEmit && tsc -p server --noEmit",
    "start": "tsx --tsconfig server/tsconfig.json server/src/index.ts",
    "test": "vitest run --config server/vitest.config.ts",
    "test:watch": "vitest --config server/vitest.config.ts",
    "db:generate": "drizzle-kit generate --config server/drizzle.config.ts",
    "db:migrate": "tsx --tsconfig server/tsconfig.json server/src/db/cli.ts migrate",
    "db:seed": "tsx --tsconfig server/tsconfig.json server/src/db/cli.ts seed",
    "db:import": "tsx --tsconfig server/tsconfig.json server/src/db/cli.ts import",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@electric-sql/pglite": "^0.5.11",
    "@fastify/compress": "9.2.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
