# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.

# Máy chủ API — dev chạy ở API_PORT (Vite chuyển tiếp /api, /auth sang đây).
# Production dùng PORT do nền tảng cấp (hoặc API_PORT nếu không có).
API_PORT=8787
WEB_ORIGIN=http://localhost:5173

# Để trống = dùng PGlite (Postgres nhúng, lưu ở server/.data/pglite) — không cần cài gì.
# Production: chuỗi kết nối PostgreSQL, ví dụ postgres://user:pass@host:5432/thuyhanlenh
DATABASE_URL=

# Đăng nhập Discord — tạo ứng dụng tại https://discord.com/developers/applications
#  → OAuth2 → thêm Redirect: http://localhost:5173/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback

# (Tùy chọn) Discord user ID của bang chủ. Trống = người đăng nhập Discord đầu tiên thành Bang Chủ.
BOOTSTRAP_LEADER_DISCORD_ID=

# Đăng nhập thử bằng tài khoản demo (không cần Discord). Đặt false ở production!
DEV_LOGIN=true

# Lần chạy đầu tạo sẵn bang demo "Kinh Hồng Các"
SEED_DEMO=true

TZ=Asia/Ho_Chi_Minh
